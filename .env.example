# --- Supabase (local: valores impresos por `supabase start`) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# apps/web necesita las mismas dos primeras también con prefijo NEXT_PUBLIC_
# (se exponen al bundle del navegador; nunca pongas ahí la service role key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Redis (docker-compose.dev.yml) ---
REDIS_URL=redis://127.0.0.1:6379

# --- App ---
NODE_ENV=development
LOG_LEVEL=debug

# --- Observabilidad (opcional en dev) ---
SENTRY_DSN=

# --- LLM local (Fase 1+): LM Studio corriendo con un modelo cargado ---
# Developer > Local Server > Start Server en la app de LM Studio.
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=

# --- Panel interno /admin (apps/web) — emails separados por coma ---
ADMIN_EMAILS=

# --- Meta / WhatsApp (Fase 3+) ---
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_CLOUD_API_TOKEN=

# --- Cifrado de credenciales de integraciones (Fase 3+) ---
INTEGRATIONS_ENCRYPTION_KEY=

# Generación de imagen (Gemini) y descripción del banco de fotos (Gemini
# vision). Sin esta clave el Creative usa solo el banco de fotos y el tick de
# etiquetado no corre. La necesitan los workers Y el dashboard en Vercel
# (regeneración de slides desde /calendar).
GEMINI_API_KEY=

# --- apps/video-editor: transcripción local con whisper.cpp ---
# brew install whisper-cpp, y descargá un modelo desde
# https://huggingface.co/ggerganov/whisper.cpp (ggml-base.bin alcanza para
# probar). Ver apps/video-editor/README.md.
WHISPER_MODEL_PATH=
WHISPER_CLI_PATH=whisper-cli

# Opcional — solo si algún preset activa limpiezaAudio. Binario nativo,
# descargalo de https://github.com/Rikorose/DeepFilterNet/releases (no
# necesita Python/PyTorch, trae su propio modelo). Ver apps/video-editor/README.md.
DEEP_FILTER_BIN_PATH=deep-filter

# Opcional — solo si usás bg-replace-cli.ts para reemplazar el fondo de una
# toma. Modelo ONNX de Robust Video Matting, descargalo de
# https://github.com/PeterL1n/RobustVideoMatting/releases
# (rvm_resnet50_fp32.onnx para calidad, rvm_mobilenetv3_fp32.onnx para
# velocidad). Corre con onnxruntime-node, ya en package.json — no necesita
# Python/PyTorch.
RVM_MODEL_PATH=
